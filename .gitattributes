# Normalize source and documentation files across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows-native command scripts retain CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never undergo line-ending conversion.
*.wav binary
*.mp3 binary
*.webm binary
*.ogg binary
*.m4a binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
