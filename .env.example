# MarhamPattii production environment variables
# Copy these names into Vercel Project Settings -> Environment Variables.
# Never commit real tokens or service-role keys.

# Supabase project URL, for example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase key used by browser-safe operations. Projects may expose either
# an anon key or a publishable key; the app supports both names.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret server-only key used by API routes for Storage and database writes.
# Do not prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret server-only Groq key used for structured healthcare intent extraction.
GROQ_API_KEY=

# Groq model used by the request API.
GROQ_MODEL_ID=openai/gpt-oss-20b

# Secret server-only Hugging Face token used for Balti ASR inference.
HF_API_TOKEN=

# Server-only HMAC secret for short-lived patient draft confirmation tokens.
# Generate at least 32 random characters, for example with: openssl rand -base64 32
DRAFT_CONFIRMATION_SECRET=
