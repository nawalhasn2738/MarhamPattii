# MarhamPattii production environment variables
# Copy these names into Vercel Project Settings -> Environment Variables.
# Never commit real tokens or service-role keys.

# REQUIRED for /api/requests. Supabase project URL, for example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase key used by browser-safe operations. Projects may expose either
# an anon key or a publishable key; the app supports both names.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# REQUIRED for /api/requests. Secret server-only key used by API routes for
# private Storage uploads and database writes through RLS.
# Do not prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED for /api/requests. Secret server-only Groq key used for structured
# healthcare intent extraction.
GROQ_API_KEY=

# OPTIONAL. Groq model used by the request API.
GROQ_MODEL_ID=openai/gpt-oss-20b

# REQUIRED for live /api/requests transcription. Secret server-only HF token.
HF_API_TOKEN=
# Optional dedicated HF endpoint; the public router does not currently deploy
# mohdali1/whisper-small-balti.
HF_ASR_ENDPOINT_URL=
# Optional production/staging presentation fallback. Never enable this for real
# patient traffic because it substitutes a fixed sample transcript.
ENABLE_ASR_DEMO_FALLBACK=false

# REQUIRED for /api/requests. Server-only HMAC secret for short-lived patient
# draft confirmation tokens.
# Generate at least 32 random characters, for example with: openssl rand -base64 32
DRAFT_CONFIRMATION_SECRET=

# Explicitly enable the pre-baked presentation request endpoint in production.
ENABLE_DEMO_MODE=false
