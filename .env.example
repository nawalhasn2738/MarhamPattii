# MarhamPattii production environment variables
# Copy the relevant values into Vercel Project Settings -> Environment Variables.

# Supabase project URL, for example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase browser/server public key.
# New Supabase projects may call this an "anon public" key or a "publishable" key.
# The app supports either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Recommended for production server-side API routes so Storage uploads and status updates
# do not depend on broad public RLS policies. Keep this secret; never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Groq key used by the Python ASR/intent pipeline.
GROQ_API_KEY=

# Current tested model. If your Groq account has access, this can be changed later.
GROQ_MODEL_ID=openai/gpt-oss-20b

# Optional: override Python executable path for local/server environments.
PYTHON_BIN=